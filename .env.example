# Environment Variables Template for Jijau Dnyanteerth Educational Campus
# Copy this file to .env.local and populate your secrets

# JWT Secret for Session Hashing & Cookie Signing
JWT_SECRET=your_jwt_secret_key_here

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare D1 Database Binding & Account Details
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000

# Cloudflare R2 Object Storage Bucket Details
CLOUDFLARE_R2_BUCKET_NAME=jijau-media
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
